{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurionAgentPassport",
  "type": "object",
  "properties": {
    "agent_id": { "type": "string" },
    "agent_name": { "type": "string" },
    "owner": { "type": "string" },
    "purpose": { "type": "string" },
    "runtime_governance": {
      "type": "object",
      "properties": {
        "zar_spend_cap_hourly": { "type": "number" },
        "human_gates_required": { "type": "array", "items": { "type": "string" } },
        "kill_switch_active": { "type": "boolean" }
      }
    }
  }
}
