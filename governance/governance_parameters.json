  "action_classes": {
    "READ_ONLY": {
      "tier": "T0",
      "description": "Reads records, computes, drafts nothing external.",
      "reversible": true
    },
    "DRAFT_INTERNAL": {
      "tier": "T0",
      "description": "Produces internal drafts not visible outside the organisation.",
      "reversible": true
    },
    "NOTIFY_THEN_ACT": {
      "tier": "T1",
      "description": "Acts immediately within caps, notifies the owner. Reversible.",
      "reversible": true
    },
    "APPROVE_THEN_ACT": {
      "tier": "T2",
      "description": "Prepares the action and waits for a named human approval.",
      "reversible": false
    },
    "HUMAN_ONLY": {
      "tier": "T3",
      "description": "Never executed by an agent. Prepared for a human, at most.",
      "reversible": false
    }
  },
